[TEMPLATE]
PORT=5000
MONGODB_URI=mongodb://localhost:27017/smart_warranty_db
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development

# ---- AI Purchase Scanner (Task 5) ----
# Provider: gemini (free tier, recommended) | openai (or any OpenAI-compatible API)
AI_PROVIDER=gemini
# Get a free key at https://aistudio.google.com/apikey  (no credit card required)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Only needed if you choose AI_PROVIDER=openai instead
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TEMPERATURE=0.2

# ---- Python ML Microservice (ML-01) ----
ML_SERVICE_URL=http://127.0.0.1:8000
ML_CATEGORY_MIN_CONFIDENCE=0.70

# ---- RAG Chatbot Gemini AI (Task RAG) ----
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
RAG_GEMINI_API_KEY=
RAG_GEMINI_MODEL=gemini-1.5-flash

